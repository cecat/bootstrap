{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(./bootstrap.sh*)",
      "Bash(./scripts/*.sh*)",
      "Bash(./verify/verify.sh*)",
      "Bash(limactl list*)",
      "Bash(limactl shell agents -- cat /etc/agent-sandbox/phase)"
    ],
    "ask": [
      "Bash(./bootstrap.sh*--rebuild*)",
      "Bash(./verify/verify.sh*--reboot*)",
      "Bash(./verify/verify.sh*--all*)",
      "Bash(./scripts/upgrade-vm.sh*)"
    ],
    "deny": [
      "Bash(limactl delete*)",
      "Bash(limactl stop*)",
      "Bash(limactl shell *agent-egress unlock*)"
    ]
  }
}
