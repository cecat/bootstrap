# argo-proxy configuration -- runs INSIDE the VM as its own user.
#
# Generated automatically by scripts/install-config.sh from the detected
# profile; copy and edit this only if you need to override something.
#
# argo-proxy is what makes Argo usable: the raw Argo endpoint does not serve a
# working Anthropic Messages API (GET /v1/models returns an empty 200 and
# POST /v1/messages hangs). argo-proxy translates, and exposes both shapes:
#   /v1/messages         -> Pi, OpenClaw
#   /v1/chat/completions -> Hermes

config_version: "3"
user: "YOUR_ANL_USERNAME"
host: 127.0.0.1
port: 44497
verbose: true
argo_base_url: "https://apps.inside.anl.gov/argoapi"
