# ===========================================================================
# Everything the build needs from you, in one file.
#
# Editing this file IS the hand-off. Nothing prompts you -- bootstrap.sh is
# built to be run by a coding agent and never asks a question. It copies
# this template to config/agents.env, prints what to fill in, and exits.
# That message is your cue, and re-running the script is how you signal you
# are done:
#
#     ./bootstrap.sh            # stops here the first time, exit 2
#     $EDITOR config/agents.env # your turn
#     ./bootstrap.sh            # continues
#
# An existing config/agents.env is kept exactly as you wrote it, so you can
# change something later by editing it and re-running. Only --rebuild
# deletes it.
#
# Defaults are fine for a first build. Never commit the filled-in copy, and
# never paste these values into a chat with an agent -- that puts them in a
# transcript you do not control. Installed into the guest at
# ~/.config/agent-sandbox/agents.env and read by the agent services through
# a systemd EnvironmentFile.
# ===========================================================================

# --- Identity ---------------------------------------------------------------
# Just names. An agent's character lives in its own SOUL.md inside the VM --
# you change that by talking to the agent ("show me your SOUL.md", "add this
# paragraph"), not by editing anything here. See docs/personality.md.
OPENCLAW_AGENT_NAME="claw-one"
HERMES_AGENT_NAME="hermes-one"

# --- Gateway auth -----------------------------------------------------------
# LEAVE BLANK. bootstrap.sh generates 64 random hex characters here.
#
# Blank on purpose, and not a shared secret: this template is public, so a
# value in it would be identical for everyone who ever cloned the repo.
# Yours is generated per install, into your gitignored copy.
#
# It authenticates CLI calls to the OpenClaw gateway inside the VM, which
# binds loopback only on a VM with no port forwards -- defence in depth
# rather than a perimeter.
OPENCLAW_GATEWAY_TOKEN=""

# --- Telegram ---------------------------------------------------------------
# Part of the base build, not an extra. Dedicated bot per agent from
# @BotFather (/newbot) -- never a personal account.
#
# Leave these blank and the agents come up mute. The channels stay disabled
# until verification passes either way, but with no token there is nothing
# to enable, and the one check no script can perform -- messaging an agent
# and watching it fetch a web page -- cannot be done at all.
# See spec/pi-target-state.md.
OPENCLAW_TELEGRAM_BOT_TOKEN=""
HERMES_TELEGRAM_BOT_TOKEN=""
# Your numeric Telegram user id -- the only account allowed to talk to the bots.
TELEGRAM_ALLOWED_USER_ID=""

# --- Your timezone -----------------------------------------------------------
# An IANA name: America/Chicago, Europe/London, Asia/Kolkata, UTC.
#
# This is the agents' clock. It decides what "2pm today" means, when a 6am
# cron job fires, and the time stamped into the agent's prompt. Leave it
# blank and the agents run on whatever zone the VM host happens to have --
# correct until someone clones this onto a machine in another zone, and then
# silently wrong rather than broken.
AGENT_TIMEZONE="America/Chicago"

# --- Local fallback model (DGX Spark, over Tailscale) ------------------------
# Leave blank to skip failover entirely.
# UNVERIFIED: the tailnet was unreachable when this repo was built, and the
# failover syntax for each agent is unconfirmed. See docs/failover.md.
VLLM_BASE_URL=""
VLLM_API_KEY=""
VLLM_MODEL=""
